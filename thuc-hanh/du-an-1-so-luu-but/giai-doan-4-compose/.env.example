# File mẫu cấu hình. Sao chép thành ".env" rồi sửa:
#   Linux / macOS / Git Bash:   cp .env.example .env
#   Windows PowerShell:         Copy-Item .env.example .env
# Compose tự đọc file ".env" nằm cùng thư mục với compose.yaml.
# File ".env" KHÔNG được đưa lên git (đã nằm trong .gitignore), vì sau này nó có thể chứa mật khẩu.

# Cổng trên máy bạn để mở trang web. Đổi nếu 8080 đã bị chương trình khác dùng.
HTTP_PORT=8080

# Tiêu đề hiện trên trang.
APP_TITLE=Sổ lưu bút Docker
